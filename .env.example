# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Finnhub quotes API (https://finnhub.io) - free tier key.
# Used only to compute unrealized P&L on open positions. Never exposed to the
# client - fetched server-side from app/api/quotes/[symbol]/route.ts.
FINNHUB_API_KEY=
